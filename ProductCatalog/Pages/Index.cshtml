@page
@model ProductCatalog.Pages.IndexModel
@{
    ViewData["Title"] = "Catálogo de produtos";
}

<h1>Catálogo de produtos</h1>

<nav>
    <a asp-page="/Index">Início</a> |
    <a asp-page="/AddProduct">Cadastrar produto</a> |
    <a asp-page="/Events/Create">Cadastrar evento</a>
</nav>

<h2>Produtos</h2>

<ul>
    @foreach (var product in Model.Products)
    {
        <li>@product.Name — @product.Price.ToString("C")</li>
    }
</ul>
